OPENAI_API_KEY=

# Structured-output label mapping (normalize/mapping.py) and disclosure-page
# transcription (extract/disclosures.py) — irdai_bot/llm.py:make_mapping_llm.
# Two ways to set this:
#   MAPPING_MODEL=gpt-5.6-luna        -> OpenAI (default)
#   MAPPING_MODEL=ollama:qwen3.8:27b  -> local Ollama server instead (OLLAMA_BASE_URL below)
# Logs "USING GPT" or "USING OLLAMA" at startup so it's obvious which is active.
MAPPING_MODEL=gpt-5.6-luna
OLLAMA_BASE_URL=http://localhost:11434

# Comparison/narration agent (graphs/analysis_graph.py) — always OpenAI, not
# affected by the Ollama switch above.
NARRATION_MODEL=gpt-5.6-terra

# Postgres: facts warehouse + ingest checkpoints (db/connection.py, checkpoint.py).
# URL-encode special characters in the password (e.g. '#' -> %23).
DATABASE_URL=postgresql://user:password@localhost:5432/irdai_bot

# Raw downloads and review files (default ./data)
IRDAI_BOT_DATA_DIR=./data

# LLM observability (irdai_bot/observability.py) — optional, tracing is a
# no-op when these are unset. Get keys from your Langfuse project settings.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
